# HTTP server
PORT=8080

# --- Security ----------------------------------------------------------------
# Public Key (Ed25519 or RSA PEM / base64) to verify asymmetric signed tokens from nexxauth.
# When set, nexxauth signs ephemeral 60s tokens with its Private Key; nexxnotify
# verifies with this Public Key and rejects duplicate tokens (JTI replay protection).
NEXXNOTIFY_PUBLIC_KEY=

# Shared secret fallback (used if public key is not set, or for static X-Api-Key)
NEXXNOTIFY_API_KEY=

# Comma-separated IPs or CIDRs allowed to call protected endpoints (optional defense-in-depth).
# e.g. NEXXNOTIFY_ALLOWED_IPS=1.2.3.4,10.0.0.0/8
# Leave blank to allow from any IP.
NEXXNOTIFY_ALLOWED_IPS=

# URL of the nexxauth backend (informational; used for logging and future callbacks).
NEXXAUTH_URL=

# Database (docker compose: postgres 16 on host port 5433)
DATABASE_URL=postgres://nexxnotify:nexxnotify@localhost:5433/nexxnotify?sslmode=disable

# --- Email: SMTP (e.g. Gmail app password) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# optional, falls back to SMTP_USERNAME
SMTP_FROM=

# --- Email: Resend ---
RESEND_API_KEY=
RESEND_FROM=

# --- Twilio (SMS / WhatsApp; email via SendGrid) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
SENDGRID_API_KEY=
SENDGRID_FROM=

# --- SMS / WhatsApp: Infobip (base URL from the Infobip portal, no scheme) ---
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_SMS_FROM=
INFOBIP_WHATSAPP_FROM=

# --- Email: Amazon SES ---
SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_FROM=

# --- Push: Firebase Cloud Messaging ---
# service account key JSON inline...
FCM_CREDENTIALS_JSON=
# ...or a path to the downloaded key file (pick one, not both)
FCM_CREDENTIALS_FILE=

# Optional explicit defaults per channel
# valid values: smtp | resend | ses | twilio | infobip | fcm
# (must be configured for that channel)
DEFAULT_EMAIL_PROVIDER=
DEFAULT_SMS_PROVIDER=
DEFAULT_WHATSAPP_PROVIDER=
DEFAULT_PUSH_PROVIDER=
